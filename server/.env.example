# Gemini API key — required for AI features
GEMINI_API_KEY=your-key-here

# Neon Postgres (from the Vercel project). Don't fill these in by hand:
# run `npm run env:pull` from the repo root, which writes them here using a
# separate "dev" schema so local work never touches production data.
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# ── Optional ─────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# GEMINI_ATTEMPT_TIMEOUT_MS=30000
# AI_DAILY_LIMIT=100

# GitHub Issues export (token needs "Issues: read & write" on the repo)
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo

# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173

# Production only: seed and advertise the public demo login
# SEED_DEMO=true
# SHOW_DEMO_LOGIN=true
